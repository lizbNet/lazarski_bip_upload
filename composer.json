{
    "name": "prime-services/lazarski-bip-upload",
    "description": "Backend module for staging and importing sets of Polish institutional documents into hidden BIP pages",
    "type": "typo3-cms-extension",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": "^8.2 || ^8.3",
        "typo3/cms-core": "^12.4 || ^13.4 || ^14.0",
        "typo3/cms-backend": "^12.4 || ^13.4 || ^14.0",
        "typo3/cms-extbase": "^12.4 || ^13.4 || ^14.0",
        "typo3/cms-fluid": "^12.4 || ^13.4 || ^14.0",
        "symfony/process": "^6.4 || ^7.0",
        "smalot/pdfparser": "^2.0",
        "phpoffice/phpword": "^1.1",
        "phpoffice/phpspreadsheet": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "PrimeServices\\LazarskiBipUpload\\": "Classes/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "lazarski_bip_upload"
        }
    }
}
